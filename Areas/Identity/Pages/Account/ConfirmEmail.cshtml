@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Xác nhận Email";
}

<div class="container mt-5 text-center">
    <h2>@ViewData["Title"]</h2>

    <div class="alert alert-info mt-4" role="alert">
        <h4>@Model.StatusMessage</h4>
    </div>

    @if (Model.StatusMessage != null && Model.StatusMessage.Contains("thành công"))
    {
        <a href="/Identity/Account/Login" class="btn btn-primary mt-3">Bấm vào đây để Đăng nhập</a>
    }
</div>