@page
@model RegisterModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-5">
                    <h2 class="text-center fw-bold text-primary mb-4">Tạo Tài Khoản Mới</h2>

                    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.HoTen" class="form-control rounded-3" placeholder="Nguyễn Văn A" aria-required="true" />
                            <label asp-for="Input.HoTen">Họ và Tên</label>
                            <span asp-validation-for="Input.HoTen" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control rounded-3" placeholder="name@example.com" aria-required="true" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control rounded-3" type="password" placeholder="Mật khẩu" aria-required="true" />
                            <label asp-for="Input.Password">Mật khẩu</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" type="password" placeholder="Xác nhận mật khẩu" aria-required="true" />
                            <label asp-for="Input.ConfirmPassword">Xác nhận mật khẩu</label>
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <hr class="my-4 text-muted">

                        <p class="text-muted small text-center mb-4">
                            Bằng cách đăng ký, bạn đồng ý với các điều khoản sử dụng của Ăn Vặt Foodie.
                        </p>

                        <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary rounded-pill shadow-sm fw-bold">Đăng Ký Ngay</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}