@model IEnumerable<WebsiteBanDoAnVat.Models.Order>
@{
    ViewData["Title"] = "Theo dõi đơn hàng";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <h3 class="text-center mb-4"><i class="fas fa-box"></i> ĐƠN HÀNG CỦA BẠN</h3>

            @if (!Model.Any())
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle me-2"></i> Bạn chưa có đơn hàng nào trong lịch sử mua hàng.
                </div>
            }
            else
            {
                @foreach (var order in Model)
                {
                    <div class="card mb-4 shadow-sm border-0">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span><strong>Mã đơn: #@order.Id</strong></span>
                            <span class="badge @(order.Status == "Thành công" ? "bg-success" : "bg-warning text-dark")">@order.Status</span>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12 px-4">
                                    <div class="track-line d-flex justify-content-between position-relative w-100">
                                        @{
                                            var s = order.Status;
                                        }
                                        <div class="track-line d-flex justify-content-between position-relative">

                                            <div class="step-item text-center @(s == "Chờ duyệt" || s == "Đang chuẩn bị" || s == "Đang giao" || s == "Hoàn thành" ? "active" : "")">
                                                <div class="dot"><i class="fas fa-clock"></i></div>
                                                <p class="small">Chờ duyệt</p>
                                            </div>

                                            <div class="step-item text-center @(s == "Đang chuẩn bị" || s == "Đang giao" || s == "Hoàn thành" ? "active" : "")">
                                                <div class="dot"><i class="fas fa-box"></i></div> <p class="small">Đang chuẩn bị</p>
                                            </div>

                                            <div class="step-item text-center @(s == "Đang giao" || s == "Hoàn thành" ? "active" : "")">
                                                <div class="dot"><i class="fas fa-truck"></i></div>
                                                <p class="small">Đang giao</p>
                                            </div>

                                            <div class="step-item text-center @(s == "Hoàn thành" ? "active" : "")">
                                                <div class="dot"><i class="fas fa-check-circle"></i></div> <p class="small">Hoàn thành</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr />
                            <div class="row">
                                <div class="col-sm-6">
                                    <p class="mb-1"><strong>Người nhận:</strong> @order.CustomerName</p>
                                    <p class="mb-1"><strong>Địa chỉ:</strong> @order.Address</p>
                                </div>
                                <div class="col-sm-6 text-sm-end">
                                    <p class="mb-1"><strong>Ngày đặt:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                                    <p class="mb-0 text-danger font-weight-bold"><strong>Tổng: @order.TotalAmount.ToString("N0")đ</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .track-line {
        position: relative;
        display: flex;
        justify-content: space-between;
        width: 100%; /* Ép dài 100% */
        padding: 40px 0; /* Tăng độ thoáng */
    }

        .track-line::before {
            content: "";
            position: absolute;
            top: 60px; /* Chỉnh cái thanh ngang nằm đúng giữa dot */
            left: 0;
            width: 100%;
            height: 3px;
            background: #e0e0e0;
            z-index: 1;
        }

    .step-item {
        flex: 1; /* Chia đều không gian để dài ra */
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .dot {
        width: 40px;
        height: 40px;
        background: #e0e0e0;
        color: #fff;
        border-radius: 50%;
        margin: 0 auto 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 4px solid #fff;
        transition: 0.3s;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .step-item.active .dot {
        background: #ff4757;
    }

    .step-item p {
        font-size: 13px; /* Tăng size chữ tí cho dễ đọc */
        margin: 0;
        color: #a4b0be;
    }

    .step-item.active p {
        color: #ff4757;
        font-weight: bold;
    }
</style>