@model WebsiteBanDoAnVat.Models.ApplicationUser
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="container mt-5">
    <div class="row">
        @* --- CỘT TRÁI: THÔNG TIN TÓM TẮT & MENU --- *@
        <div class="col-md-4 text-center border-end">
            <div class="position-relative d-inline-block">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)"
                     id="avatarPreview" class="rounded-circle img-thumbnail shadow-sm" style="width: 200px; height: 200px; object-fit: cover;">
            </div>
            <h4 class="mt-3 fw-bold">@Model.HoTen</h4>
            <p class="text-muted">@Model.Email</p>

            <hr class="my-3 mx-5">

            @* --- THÊM MENU TIỆN ÍCH --- *@
            <div class="list-group list-group-flush text-start px-3">
                <a asp-controller="Profile" asp-action="Index" class="list-group-item list-group-item-action border-0 active rounded-3 mb-2">
                    <i class="fas fa-user-circle me-2"></i> Thông tin cá nhân
                </a>
                <a asp-controller="Profile" asp-action="TrackingOrder" class="list-group-item list-group-item-action border-0 rounded-3 mb-2">
                    <i class="fas fa-box me-2 text-danger"></i> Đơn hàng của tôi
                </a>
            </div>
        </div>

        @* --- CỘT PHẢI: FORM CHỈNH SỬA --- *@
        <div class="col-md-8 ps-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h3 class="mb-4 fw-bold text-dark"><i class="fas fa-edit me-2 text-primary"></i>Thông tin cá nhân</h3>

                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Họ và Tên</label>
                            <input type="text" name="hoTen" class="form-control rounded-3" value="@Model.HoTen" required placeholder="Nhập họ tên...">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="text" name="phoneNumber" class="form-control rounded-3" value="@Model.PhoneNumber" placeholder="Nhập số điện thoại...">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-semibold">Địa chỉ giao hàng</label>
                            <textarea name="diaChi" class="form-control rounded-3" rows="3" placeholder="Nhập địa chỉ nhận hàng chi tiết...">@Model.DiaChi</textarea>
                        </div>
                        <div class="col-md-12 mb-4">
                            <label class="form-label fw-semibold">Thay đổi ảnh đại diện</label>
                            <input type="file" name="avatarFile" class="form-control rounded-3" onchange="previewImage(this)">
                            <div class="form-text">Định dạng hỗ trợ: JPG, PNG. Dung lượng tối đa 2MB.</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-save me-2"></i>LƯU THAY ĐỔI
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    // Nhớ kiểm tra ID này có khớp với ID của thẻ <img> avatar không nha
                    $('#anhDaiDien').attr('src', e.target.result);
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
</script>