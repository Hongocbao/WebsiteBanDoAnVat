                    }

                        .nav-link:hover {
                            color: #333 !important;
                        }

                    /* Hiệu ứng cho các trang con */
                    .hero-section {
                        background: #f8f9fa;
                        padding: 60px 0;
                        border-bottom: 2px solid #eee;
                    }

                    footer {
                        background: #333;
                        color: white;
                        padding: 30px 0;
                        margin-top: 50px;
                    }

                    /* Đảm bảo nội dung không bị dính vào Header */
                    main {
                        min-height: 70vh;
                    }
                </style>
            </head>
            <body>
                <header>
                    <nav class="navbar navbar-expand-lg custom-navbar shadow-sm sticky-top">
