                                <span class="fw-bold text-success item-qty-8">1</span>
                                <button class="btn btn-sm text-success fw-bold increase-btn" data-id="8" style="width: 25px;">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                        <img src="https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=400" class="card-img-top" style="height: 180px; object-fit: cover;">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold" style="font-size: 0.9rem;">Bánh Tráng Tôm Sấy Giòn</h6>
                            <p class="text-warning fs-6 fw-bold mb-0">130.000đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 d-flex justify-content-end product-action-9">
                            <button class="btn btn-success rounded-circle add-to-cart-btn" style="width: 40px; height: 40px; padding: 0;"
                                    data-id="9" data-name="Bánh Tráng Tôm Sấy Giòn" data-price="130000" data-image="https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=400">
                                <i class="fas fa-shopping-bag"></i>
                            </button>
                            <div class="quantity-control d-none justify-content-between align-items-center border border-success rounded-pill px-2 py-1 w-100">
                                <button class="btn btn-sm text-success fw-bold decrease-btn" data-id="9" style="width: 25px;">-</button>
                                <span class="fw-bold text-success item-qty-9">1</span>
                                <button class="btn btn-sm text-success fw-bold increase-btn" data-id="9" style="width: 25px;">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                        <img src="https://images.unsplash.com/photo-1621236322951-f073527a4411?w=400" class="card-img-top" style="height: 180px; object-fit: cover;">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold" style="font-size: 0.9rem;">Kẹo đậu phộng xốp bơ</h6>
                            <p class="text-warning fs-6 fw-bold mb-0">125.000đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 d-flex justify-content-end product-action-10">
                            <button class="btn btn-success rounded-circle add-to-cart-btn" style="width: 40px; height: 40px; padding: 0;"
                                    data-id="10" data-name="Kẹo đậu phộng xốp bơ" data-price="125000" data-image="https://images.unsplash.com/photo-1621236322951-f073527a4411?w=400">
                                <i class="fas fa-shopping-bag"></i>
                            </button>
                            <div class="quantity-control d-none justify-content-between align-items-center border border-success rounded-pill px-2 py-1 w-100">
                                <button class="btn btn-sm text-success fw-bold decrease-btn" data-id="10" style="width: 25px;">-</button>
                                <span class="fw-bold text-success item-qty-10">1</span>
                                <button class="btn btn-sm text-success fw-bold increase-btn" data-id="10" style="width: 25px;">+</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                        <img src="https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=400" class="card-img-top" style="height: 180px; object-fit: cover;">
                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold" style="font-size: 0.9rem;">Combo bánh tráng tóp tép</h6>
                            <p class="text-warning fs-6 fw-bold mb-0">140.000đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 d-flex justify-content-end product-action-11">
                            <button class="btn btn-success rounded-circle add-to-cart-btn" style="width: 40px; height: 40px; padding: 0;"
                                    data-id="11" data-name="Combo bánh tráng tóp tép" data-price="140000" data-image="https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=400">
                                <i class="fas fa-shopping-bag"></i>
                            </button>
                            <div class="quantity-control d-none justify-content-between align-items-center border border-success rounded-pill px-2 py-1 w-100">
                                <button class="btn btn-sm text-success fw-bold decrease-btn" data-id="11" style="width: 25px;">-</button>
                                <span class="fw-bold text-success item-qty-11">1</span>
                                <button class="btn btn-sm text-success fw-bold increase-btn" data-id="11" style="width: 25px;">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

            <nav aria-label="Page navigation" class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link rounded-circle me-2" href="#" tabindex="-1" aria-disabled="true"><i class="fas fa-chevron-left"></i></a></li>
                    <li class="page-item active"><a class="page-link rounded-circle me-2 bg-success border-success text-white" href="#">1</a></li>
                    <li class="page-item"><a class="page-link rounded-circle me-2 text-dark" href="#">2</a></li>
                    <li class="page-item"><a class="page-link rounded-circle me-2 text-dark" href="#">3</a></li>
                    <li class="page-item"><span class="page-link rounded-circle me-2 border-0 text-dark">...</span></li>
                    <li class="page-item"><a class="page-link rounded-circle me-2 text-dark" href="#">28</a></li>
                    <li class="page-item"><a class="page-link rounded-circle text-dark" href="#"><i class="fas fa-chevron-right"></i></a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>