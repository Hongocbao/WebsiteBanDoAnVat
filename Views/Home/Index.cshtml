@{
    ViewData["Title"] = "Trang Chủ";
}
<div class="p-5 mb-4 bg-light rounded-3 text-center" style="background: url('https://images.unsplash.com/photo-1513104890138-7c749659a591?q=80&w=1000') center/cover; color: white;">
    <div class="container-fluid py-5" style="background: rgba(0,0,0,0.5); border-radius: 15px;">
        <h1 class="display-5 fw-bold">Ăn Vặt Foodie - Ăn Là Ghiền!</h1>
        <p class="fs-4">Tổng hợp các món ăn vặt hot nhất hiện nay, giao hàng siêu tốc.</p>
        <button class="btn btn-warning btn-lg" type="button">Xem Thực Đơn</button>
    </div>
</div>

<div class="container">
    <h2 class="text-center my-4">Món Ăn Bán Chạy</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1621236322951-f073527a4411?w=400" class="card-img-top" alt="Bánh tráng">
                <div class="card-body">
                    <h5 class="card-title">Bánh Tráng Trộn</h5>
                    <p class="card-text text-danger fw-bold">25.000đ</p>
                    <a href="#" class="btn btn-outline-primary">Thêm vào giỏ</a>
                </div>
            </div>
        </div>
    </div>
</div>