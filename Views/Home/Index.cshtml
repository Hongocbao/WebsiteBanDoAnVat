                        <div class="card-body p-3">
                            <h6 class="card-title fw-bold" style="font-size: 0.9rem;">Khô Cá Thiều Muối Ớt</h6>
                            <p class="text-warning fs-6 fw-bold mb-0">200.000đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 d-flex justify-content-end product-action-8">
                            <button class="btn btn-success rounded-circle add-to-cart-btn" style="width: 40px; height: 40px; padding: 0;"
                                    data-id="8" data-name="Khô Cá Thiều Muối Ớt" data-price="200000" data-image="https://images.unsplash.com/photo-1621236322951-f073527a4411?w=400">
