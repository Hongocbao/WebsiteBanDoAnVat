@model WebsiteBanDoAnVat.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang Chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}

<div class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center bg-dark text-white rounded-5 home-hero">
    <div class="col-md-6 p-lg-5 mx-auto my-5">
        <h1 class="display-3 fw-bold">Ăn vặt cực đã!</h1>
        <h3 class="fw-normal mb-4 text-warning">Giao hàng siêu tốc - Giá rẻ bất ngờ</h3>
        <a class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow-lg" href="#">Mua Ngay</a>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        @foreach (var item in new[] {
                (Icon: "fa-box-open", Title: "Hàng hoá", Sub: "Luôn luôn tươi ngon"),
                (Icon: "fa-truck-fast", Title: "Giao hàng", Sub: "Nhanh chóng, tiết kiệm"),
                (Icon: "fa-headset", Title: "Tư vấn", Sub: "Chu đáo, tận tâm"),
                (Icon: "fa-shield-halved", Title: "Thực phẩm", Sub: "Vệ sinh, an toàn")
                })
        {
            <div class="col-6 col-md-3">
                <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                    <i class="fas @item.Icon fs-3 text-success me-3"></i>
                    <div>
                        <h6 class="fw-bold mb-1">@item.Title</h6>
                        <small class="text-muted service-icon-text">@item.Sub</small>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="container my-5 bg-success bg-opacity-10 p-4 p-md-5 rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-success"><i class="fas fa-medal me-2"></i>Sản phẩm bán chạy</h3>
        <a asp-controller="Home" asp-action="SanPham" class="btn btn-light text-success fw-bold rounded-pill px-4 shadow-sm">Xem Thêm</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (Model?.BestSellers != null)
        {
            @foreach (var item in Model.BestSellers)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card bg-white">
                        <img src="@item.ImageUrl" class="card-img-top product-img" alt="@item.Name">
                        <div class="card-body">
                            <h6 class="card-title fw-bold">@item.Name</h6>
                            <p class="text-success fs-6 fw-bold mb-0">@item.Price.ToString("N0")đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 product-action-@item.Id">
                            <button class="btn btn-outline-success w-100 rounded-pill fw-bold add-to-cart-btn" data-id="@item.Id">
                                <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="container my-5 pb-5">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold text-danger mb-4"><i class="fas fa-utensils me-2"></i>Danh Mục</h5>
                <ul class="nav flex-column gap-3">
                    @if (Model?.Categories != null)
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <li class="nav-item">
                                <a asp-action="SanPham" asp-route-categoryId="@cat.Id" class="nav-link p-0 text-dark d-flex align-items-center">
                                    <i class="fas fa-chevron-right me-2 text-secondary category-icon-small"></i>
                                    <span>@cat.Name</span>
                                </a>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @if (Model?.AllProducts != null)
                {
                    @foreach (var item in Model.AllProducts.Take(12))
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                                <img src="@item.ImageUrl" class="card-img-top product-img-sm" alt="@item.Name">
                                <div class="card-body p-3">
                                    <h6 class="card-title fw-bold text-truncate" style="font-size: 0.9rem;">@item.Name</h6>
                                    <p class="text-warning fs-6 fw-bold mb-0">@item.Price.ToString("N0")đ</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3 px-3 d-flex justify-content-end">
                                    <button class="btn btn-success rounded-circle btn-cart-circle add-to-cart-btn" data-id="@item.Id">
                                        <i class="fas fa-shopping-bag"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>