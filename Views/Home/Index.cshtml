@{
    ViewData["Title"] = "Home Page";
}

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">Thế Giới Đồ Ăn Vặt <span style="color: #ff6b6b;">Siêu Ngon</span></h1>
        <p class="lead">Hàng ngàn món ăn vặt hấp dẫn đang chờ bạn khám phá!</p>
        <a href="#" class="btn btn-danger btn-lg px-5">Đặt hàng ngay</a>
    </div>
</div>

<div class="container mt-5">
    <h3 class="text-center mb-4">Món Ngon Nổi Bật</h3>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card card-food h-100">
                <img src="https://images.unsplash.com/photo-1621236322951-f073527a4411?q=80&w=500" class="card-img-top" alt="Bánh tráng trộn">
                <div class="card-body">
                    <h5 class="card-title">Bánh Tráng Trộn Full Topping</h5>
                    <p class="card-text text-danger fw-bold">25.000đ</p>
                    <button class="btn btn-outline-danger w-100">Thêm vào giỏ</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-food h-100">
                <img src="https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?q=80&w=500" class="card-img-top" alt="Chân gà sả tắc">
                <div class="card-body">
                    <h5 class="card-title">Chân Gà Sả Tắc Cay Cay</h5>
                    <p class="card-text text-danger fw-bold">45.000đ</p>
                    <button class="btn btn-outline-danger w-100">Thêm vào giỏ</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-food h-100">
                <img src="https://images.unsplash.com/photo-1559739511-33bc007671f0?q=80&w=500" class="card-img-top" alt="Trà sữa">
                <div class="card-body">
                    <h5 class="card-title">Trà Sữa Full Thạch</h5>
                    <p class="card-text text-danger fw-bold">30.000đ</p>
                    <button class="btn btn-outline-danger w-100">Thêm vào giỏ</button>
                </div>
            </div>
        </div>
    </div>
</div>