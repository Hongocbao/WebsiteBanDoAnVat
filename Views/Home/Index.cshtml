@model WebsiteBanDoAnVat.Models.HomeViewModel

@{
    ViewData["Title"] = "Trang Chủ";
}

@section Styles {
    <style>
        html {
            scroll-behavior: smooth;
        }
        .product-card {
            transition: all 0.3s ease;
            border: 1px solid #eee !important;
            border-radius: 20px !important;
        }

            .product-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            }

        .btn-action {
            border-radius: 50px;
            font-weight: bold;
            transition: all 0.2s;
        }

        .product-img-container {
            position: relative;
            overflow: hidden;
            height: 180px;
        }

        .product-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s;
        }

        .product-card:hover .product-img {
            transform: scale(1.1);
        }

        .badge-hot {
            position: absolute; 
            top: 10px;
            left: 10px;
            z-index: 2;
        }
    </style>
}

@* 1. Hero Section (Banner) *@
<div class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center bg-dark text-white rounded-5 shadow-lg"
     style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/banner-snack.jpg'); background-position: center; background-size: cover;">
    <div class="col-md-6 p-lg-5 mx-auto my-5">
        <h1 class="display-3 fw-bold text-warning">Ăn vặt cực đã!</h1>
        <h3 class="fw-normal mb-4">Giao hàng siêu tốc - Ăn là nghiện</h3>
        <a class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow" href="#shop-section">MUA NGAY</a>
    </div>
</div>

@* 2. Service Icons *@
<div class="container my-5 text-center">
    <div class="row g-4">
        @foreach (var s in new[] { ("fa-box", "Hàng hoá", "Tươi ngon"), ("fa-truck", "Giao hàng", "Siêu tốc"), ("fa-headset", "Tư vấn", "24/7"), ("fa-shield-heart", "An toàn", "Vệ sinh") })
        {
            <div class="col-6 col-md-3">
                <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                    <i class="fas @s.Item1 fs-3 text-success me-3"></i>
                    <div class="text-start">
                        <h6 class="fw-bold mb-0">@s.Item2</h6>
                        <small class="text-muted">@s.Item3</small>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@* 3. Sản phẩm bán chạy (Best Sellers) *@
<div class="container my-5 bg-danger bg-opacity-10 p-4 p-md-5 rounded-5" id="shop-section">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-danger"><i class="fas fa-fire me-2"></i>SẢN PHẨM ĐANG HOT</h3>
        <a asp-action="SanPham" class="btn btn-danger rounded-pill px-4">Xem tất cả</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (Model.BestSellers != null)
        {
            @foreach (var item in Model.BestSellers)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm product-card bg-white">
                        <div class="product-img-container">
                            @if (item.IsBestSeller)
                            {
                                <span class="badge bg-danger badge-hot px-3 py-2 rounded-pill shadow-sm">🔥 Bán chạy</span>
                            }
                            else if (item.ViewCount > 50) // Ví dụ: trên 50 lượt xem thì cho là HOT
                            {
                                <span class="badge bg-warning text-dark badge-hot px-3 py-2 rounded-pill shadow-sm">🌟 HOT</span>
                            }
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" class="product-img" alt="@item.Name" onerror="this.onerror=null; this.src='/images/no-image.png';">
                            </a>
                        </div>
                        <div class="card-body text-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                <h6 class="card-title fw-bold text-dark">@item.Name</h6>
                            </a>
                            <p class="text-danger fs-5 fw-bold mb-3">@item.Price.ToString("N0")đ</p>

                            <div class="d-flex gap-2 product-action-@item.Id">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary btn-action w-50" style="font-size: 0.8rem;">
                                    <i class="fas fa-info-circle me-1"></i>Chi tiết
                                </a>
                                <button class="btn btn-sm btn-danger btn-action w-50 add-to-cart-btn"
                                        style="font-size: 0.8rem;"
                                        data-id="@item.Id" data-name="@item.Name" data-price="@item.Price" data-image="@item.ImageUrl">
                                    <i class="fas fa-cart-plus me-1"></i>Thêm
                                </button>
                                <div class="quantity-control d-none w-50 justify-content-between align-items-center border border-danger rounded-pill px-1 py-1 bg-white">
                                    <button class="btn btn-sm text-danger fw-bold decrease-btn p-0" data-id="@item.Id" style="width: 20px;">-</button>
                                    <span class="fw-bold text-danger item-qty-@item.Id" style="font-size: 0.8rem;">1</span>
                                    <button class="btn btn-sm text-danger fw-bold increase-btn p-0" data-id="@item.Id" style="width: 20px;">+</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@* 4. Danh mục và Sản phẩm mới *@
<div class="container my-5 pb-5" id="goi-y-section">
    <div class="row g-4">
        <div class="col-lg-3">
            <div class="bg-white p-4 rounded-4 shadow-sm border" style="position: sticky; top: 20px;">
                <h5 class="fw-bold text-success mb-4"><i class="fas fa-list me-2"></i>DANH MỤC</h5>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-categoryId="" asp-fragment="goi-y-section"
                       class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(ViewBag.CurrentCategoryId == null ? "fw-bold text-success" : "")">
                        <span><i class="fas fa-chevron-right me-2 text-muted small"></i>Tất cả</span>
                    </a>

                    @if (Model.Categories != null)
                    {
                        foreach (var cat in Model.Categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-fragment="goi-y-section"
                               class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(ViewBag.CurrentCategoryId == cat.Id ? "fw-bold text-success" : "")">
                                <span><i class="fas fa-chevron-right me-2 text-muted small"></i>@cat.Name</span>
                            </a>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <h4 class="fw-bold mb-4 text-uppercase">GỢI Ý CHO BẠN</h4>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @if (Model.AllProducts != null)
                {
                    foreach (var item in Model.AllProducts)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <div class="product-img-container" style="height: 150px;">
                                    <a asp-action="Details" asp-route-id="@item.Id">
                                        <img src="@item.ImageUrl" class="product-img" alt="@item.Name" onerror="this.onerror=null; this.src='/images/no-image.png';">
                                    </a>
                                </div>
                                <div class="card-body p-3 text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        <h6 class="fw-bold text-truncate mb-1">@item.Name</h6>
                                    </a>
                                    <p class="text-success fw-bold mb-3">@item.Price.ToString("N0")đ</p>

                                    <div class="product-action-@item.Id">
                                        <button class="btn btn-sm btn-outline-success w-100 rounded-pill add-to-cart-btn fw-bold py-2"
                                                data-id="@item.Id" data-name="@item.Name" data-price="@item.Price" data-image="@item.ImageUrl">
                                            <i class="fas fa-plus me-1"></i>Thêm vào giỏ
                                        </button>
                                        <div class="quantity-control d-none justify-content-between align-items-center border border-success rounded-pill px-2 py-1 w-100 bg-white">
                                            <button class="btn btn-sm text-success fw-bold decrease-btn p-0" data-id="@item.Id" style="width: 25px;">-</button>
                                            <span class="fw-bold text-success item-qty-@item.Id">1</span>
                                            <button class="btn btn-sm text-success fw-bold increase-btn p-0" data-id="@item.Id" style="width: 25px;">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (ViewBag.TotalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-5">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link rounded-circle mx-1 border-0 shadow-sm text-success"
                               asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)"
                               asp-route-categoryId="@ViewBag.CurrentCategoryId"
                               asp-fragment="goi-y-section">
                                <i class="fas fa-angle-left"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link rounded-circle mx-1 border-0 shadow-sm @(i == ViewBag.CurrentPage ? "bg-success border-success text-white" : "text-success")"
                                   asp-action="Index" asp-route-page="@i"
                                   asp-route-categoryId="@ViewBag.CurrentCategoryId"
                                   asp-fragment="goi-y-section">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link rounded-circle mx-1 border-0 shadow-sm text-success"
                               asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)"
                               asp-route-categoryId="@ViewBag.CurrentCategoryId"
                               asp-fragment="goi-y-section">
                                <i class="fas fa-angle-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
