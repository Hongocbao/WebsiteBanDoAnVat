@model WebsiteBanDoAnVat.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="position-relative overflow-hidden p-3 p-md-5 m-md-3 text-center bg-dark text-white rounded-5"
     style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=1200') center/cover;">
    <div class="col-md-6 p-lg-5 mx-auto my-5">
        <h1 class="display-3 fw-bold">Ăn vặt cực đã!</h1>
        <h3 class="fw-normal mb-4 text-warning">Giao hàng siêu tốc - Giá rẻ bất ngờ</h3>
        <a class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow-lg" href="#">Mua Ngay</a>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4">
        <div class="col-6 col-md-3">
            <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                <i class="fas fa-box-open fs-3 text-success me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Hàng hoá</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">Luôn luôn tươi ngon</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                <i class="fas fa-truck-fast fs-3 text-success me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Giao hàng</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">Nhanh chóng, tiết kiệm</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                <i class="fas fa-headset fs-3 text-success me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Tư vấn</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">Chu đáo, tận tâm</small>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bg-white p-3 rounded-4 shadow-sm border h-100 d-flex align-items-center justify-content-center">
                <i class="fas fa-shield-halved fs-3 text-success me-3"></i>
                <div>
                    <h6 class="fw-bold mb-1">Thực phẩm</h6>
                    <small class="text-muted" style="font-size: 0.75rem;">Vệ sinh, an toàn</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5 bg-success bg-opacity-10 p-4 p-md-5 rounded-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-success"><i class="fas fa-medal me-2"></i>Sản phẩm bán chạy</h3>
        <a asp-controller="Home" asp-action="SanPham" class="btn btn-light text-success fw-bold rounded-pill px-4 shadow-sm">Xem Thêm</a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        @if (Model?.BestSellers != null)
        {
            @foreach (var item in Model.BestSellers)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card bg-white">
                        <div class="position-relative">
                            <img src="@item.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Name">
                        </div>
                        <div class="card-body">
                            <h6 class="card-title fw-bold">@item.Name</h6>
                            <p class="text-success fs-6 fw-bold mb-0">@item.Price.ToString("N0")đ</p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3 product-action-@item.Id">
                            <button class="btn btn-outline-success w-100 rounded-pill fw-bold add-to-cart-btn"
                                    data-id="@item.Id"
                                    data-name="@item.Name"
                                    data-price="@item.Price"
                                    data-image="@item.ImageUrl">
                                <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                            </button>
                            <div class="quantity-control d-none justify-content-between align-items-center border border-success rounded-pill px-2 py-1">
                                <button class="btn btn-sm text-success fw-bold decrease-btn" data-id="@item.Id" style="width: 30px;"><i class="fas fa-minus"></i></button>
                                <span class="fw-bold text-success item-qty-@item.Id">1</span>
                                <button class="btn btn-sm text-success fw-bold increase-btn" data-id="@item.Id" style="width: 30px;"><i class="fas fa-plus"></i></button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="fas fa-box text-warning me-2"></i>Sản phẩm mới ra mắt</h3>
        <a asp-controller="Home" asp-action="SanPham" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">Tất cả danh mục</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="rounded-4 overflow-hidden h-100 d-flex align-items-center justify-content-center shadow-sm" style="background-color: #fce7a1; min-height: 250px;">
                <div class="text-center">
                    <h2 class="fw-bold text-success mb-0" style="font-size: 2.5rem;">MỚI</h2>
                    <h3 class="fw-bold text-warning" style="font-size: 1.8rem; -webkit-text-stroke: 1px white;">CẬP NHẬT</h3>
                </div>
            </div>
        </div>
        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @if (Model?.NewProducts != null)
                {
                    @foreach (var item in Model.NewProducts)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">
                                <img src="@item.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Name">
                                <div class="card-body">
                                    <h6 class="card-title fw-bold">@item.Name</h6>
                                    <p class="text-warning fs-6 fw-bold mb-0">@item.Price.ToString("N0")đ</p>
                                </div>
                                <div class="card-footer bg-transparent border-0 pb-3 px-3 product-action-@item.Id">
                                    <button class="btn btn-outline-warning w-100 rounded-pill fw-bold add-to-cart-btn"
                                            data-id="@item.Id"
                                            data-name="@item.Name"
                                            data-price="@item.Price"
                                            data-image="@item.ImageUrl">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm
                                    </button>
                                    <div class="quantity-control d-none justify-content-between align-items-center border border-warning rounded-pill px-2 py-1">
                                        <button class="btn btn-sm text-warning fw-bold decrease-btn" data-id="@item.Id" style="width: 30px;"><i class="fas fa-minus"></i></button>
                                        <span class="fw-bold text-warning item-qty-@item.Id">1</span>
                                        <button class="btn btn-sm text-warning fw-bold increase-btn" data-id="@item.Id" style="width: 30px;"><i class="fas fa-plus"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<div class="container my-5 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold"><i class="fas fa-th-large text-danger me-2"></i>Danh mục sản phẩm</h3>
        <a asp-controller="Home" asp-action="SanPham" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">Xem thêm</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-3">
            <div class="p-3 rounded-4" style="background-color: #fdf5d3;">
                <ul class="nav flex-column gap-2">
                    <li class="nav-item"><a href="#" class="nav-link text-dark fw-bold rounded-3" style="background-color: #fce7a1;">Tất cả</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Bánh tráng</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Bò</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Mực</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Cá</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Heo</a></li>
                    <li class="nav-item"><a href="#" class="nav-link text-dark">Gà</a></li>
                </ul>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
