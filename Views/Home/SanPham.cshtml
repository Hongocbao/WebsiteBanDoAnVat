@model IEnumerable<WebsiteBanDoAnVat.Models.MonAn>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm p-3" style="border-radius: 20px; position: sticky; top: 20px;">
                <h5 class="fw-bold mb-3" style="color: #ff4d4d;"><i class="fas fa-utensils me-2"></i>Danh Mục</h5>
                <div class="list-group list-group-flush category-menu">
                    <a href="@Url.Action("SanPham", "Home")" class="list-group-item list-group-item-action border-0 px-0 py-2">
                        <i class="fas fa-chevron-right me-2 small"></i> Tất cả món ăn
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-2">
                        <i class="fas fa-chevron-right me-2 small"></i> Đồ ăn vặt khô
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-2">
                        <i class="fas fa-chevron-right me-2 small"></i> Trà sữa & Đồ uống
                    </a>
                    <a href="#" class="list-group-item list-group-item-action border-0 px-0 py-2">
                        <i class="fas fa-chevron-right me-2 small"></i> Đồ chiên nóng hổi
                    </a>
                </div>

                <hr>
                <h5 class="fw-bold mb-3" style="color: #ff4d4d;"><i class="fas fa-filter me-2"></i>Khoảng giá</h5>
                <div class="d-flex flex-column gap-2">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="priceRange" id="p1">
                        <label class="form-check-label small" for="p1">Dưới 50.000đ</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="priceRange" id="p2">
                        <label class="form-check-label small" for="p2">50.000đ - 150.000đ</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex flex-wrap gap-2 mb-4 justify-content-center">
                <a asp-action="SanPham" asp-route-filter="" class="btn btn-outline-secondary rounded-pill px-4">Tất cả</a>
                <a asp-action="SanPham" asp-route-filter="banchay" class="btn btn-outline-danger rounded-pill px-4">🔥 Bán chạy</a>
                <a asp-action="SanPham" asp-route-filter="moinhat" class="btn btn-outline-primary rounded-pill px-4">✨ Mới nhất</a>
                <a asp-action="SanPham" asp-route-filter="hot" class="btn btn-outline-warning rounded-pill px-4">🌟 Đang HOT</a>
                <a asp-action="SanPham" asp-route-filter="giamgia" class="btn btn-outline-success rounded-pill px-4">💸 Giảm giá</a>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-uppercase fw-bold fs-4" style="color: #ff4d4d; border-left: 5px solid #ff4d4d; padding-left: 15px;">
                    Thực Đơn Ăn Vặt
                </h2>
                <span class="badge bg-danger rounded-pill">@Model.Count() món</span>
            </div>

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                @foreach (var item in Model)
                {
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Thêm CSS cho menu phân loại */
    .category-menu .list-group-item {
        transition: all 0.2s;
        font-weight: 500;
        color: #555;
    }

        .category-menu .list-group-item:hover {
            color: #ff4d4d;
            padding-left: 10px !important;
            background-color: transparent;
        }
    /* Giữ nguyên các style Hover Card của Bảo */
    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
</style>