@model IEnumerable<WebsiteBanDoAnVat.Models.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container-fluid mt-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-list-alt me-2"></i>DANH SÁCH ĐƠN HÀNG</h2>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Mã Đơn</th>
                        <th>Thời Gian Đặt</th>
                        <th>Tên Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.CustomerName</td>
                            <td>@order.PhoneNumber</td>
                            <td class="text-danger fw-bold">@order.TotalAmount.ToString("N0") VNĐ</td>
                            <td>
                                <span class="badge @(order.Status == "Chờ duyệt" ? "bg-warning text-dark" : "bg-success")">
                                    @order.Status
                                </span>
                            </td>
                            <td class="text-center">
                                @* ĐÃ SỬA: asp-controller là AdminProduct và asp-action là OrderDetail *@
                                <a asp-controller="AdminProduct"
                                   asp-action="OrderDetail"
                                   asp-route-id="@order.Id"
                                   class="btn btn-sm btn-info text-white rounded-pill px-3">
                                    <i class="fas fa-eye me-1"></i> Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>