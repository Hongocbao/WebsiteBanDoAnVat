@model WebsiteBanDoAnVat.Models.MonAn
@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="row bg-white p-4 shadow-sm rounded-4 border">
        <div class="col-md-5 text-center">
            <img src="@Model.ImageUrl" class="img-fluid rounded-4 shadow-sm" style="max-height: 400px; width: 100%; object-fit: cover;" alt="@Model.Name">
        </div>
        <div class="col-md-7 ps-md-5 pt-4 pt-md-0">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>
            <h1 class="fw-bold text-dark">@Model.Name</h1>
            <div class="d-flex align-items-center gap-2 mb-3 text-warning">
                <i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i>
                <span class="text-muted small ms-2">(@(Model.DanhGias?.Count ?? 0) đánh giá)</span>
            </div>
            <h3 class="text-danger fw-bold">@Model.Price.ToString("N0") VNĐ</h3>
            <hr>
            <p class="text-muted" style="line-height: 1.8;">@Model.Description</p>

            <div class="mt-4 d-flex align-items-center gap-3">
                <div class="d-flex align-items-center border rounded-pill p-1 bg-light shadow-sm" style="width: 140px; height: 55px;">
                    <button type="button" class="btn btn-link text-dark fw-bold text-decoration-none px-3" onclick="changeDetailQty(-1)">-</button>
                    <input type="text" id="detailQty" class="form-control border-0 bg-transparent text-center fw-bold p-0"
                           value="1" readonly
                           style="box-shadow: none; width: 40px; font-size: 1.2rem;">
                    <button type="button" class="btn btn-link text-dark fw-bold text-decoration-none px-3" onclick="changeDetailQty(1)">+</button>
                </div>

                <button type="button" class="btn text-white btn-lg px-5 rounded-pill fw-bold shadow-sm"
                        onclick="addToCartFromDetail(this)"
                        data-id="@Model.Id"
                        data-name="@Model.Name"
                        data-price="@Model.Price"
                        data-image="@Model.ImageUrl"
                        style="background-color: #81B64C; flex-grow: 1; height: 55px;">
                    THÊM VÀO GIỎ HÀNG <i class="fas fa-shopping-bag ms-2"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="row mt-5 bg-white p-4 shadow-sm rounded-4 mb-5 border">
        <div class="col-12">
            <h4 class="fw-bold mb-4 border-bottom pb-2 text-uppercase">Đánh giá từ khách hàng</h4>

            <div class="mb-5 p-4 border rounded-3 bg-light shadow-sm">
                <h6 class="fw-bold mb-3"><i class="fas fa-edit me-2"></i>Gửi nhận xét của bạn</h6>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-action="PostComment" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="MonAnId" value="@Model.Id" />
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label class="form-label small fw-bold">Xếp hạng:</label>
                                <select name="SoSao" class="form-select text-warning fw-bold">
                                    <option value="5">⭐⭐⭐⭐⭐</option>
                                    <option value="4">⭐⭐⭐⭐</option>
                                    <option value="3">⭐⭐⭐</option>
                                    <option value="2">⭐⭐</option>
                                    <option value="1">⭐</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <textarea name="NoiDung" class="form-control shadow-sm" rows="3" placeholder="Món ăn này có hương vị thế nào?..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="small fw-bold"><i class="fas fa-camera me-1"></i>Thêm hình ảnh thực tế:</label>
                            <input type="file" name="imageFile" class="form-control form-control-sm shadow-sm" accept="image/*">
                        </div>
                        <button type="submit" class="btn btn-dark px-5 rounded-pill shadow-sm">Gửi đánh giá</button>
                    </form>
                }
                else
                {
                    <div class="text-center py-3">
                        <p class="text-muted">Vui lòng đăng nhập để gửi đánh giá cho món ăn này.</p>
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="fas fa-sign-in-alt me-2"></i> Đăng nhập ngay
                        </a>
                    </div>
                }
            </div>

            <div class="review-list mt-4">
                @if (Model.DanhGias != null && Model.DanhGias.Any())
                {
                    @foreach (var d in Model.DanhGias.OrderByDescending(x => x.NgayDang))
                    {
                        <div class="d-flex gap-3 mb-4 border-bottom pb-3">
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center shadow-sm fw-bold" style="width: 50px; height: 50px; flex-shrink: 0;">
                                @(string.IsNullOrEmpty(d.UserName) ? "K" : d.UserName.Substring(0, 1).ToUpper())
                            </div>
                            <div class="w-100">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="fw-bold mb-0 text-primary">@d.UserName</h6>
                                    <small class="text-muted">@d.NgayDang.ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <div class="text-warning small my-1">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= d.SoSao ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                                <p class="mb-1 text-dark">@d.NoiDung</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted italic">Chưa có bình luận nào cho món này.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Hàm tăng giảm số lượng
        function changeDetailQty(amount) {
            const input = document.getElementById('detailQty');
            let currentVal = parseInt(input.value) || 1;
            currentVal += amount;
            if (currentVal < 1) currentVal = 1;
            input.value = currentVal;
        }

        // 2. Hàm thêm vào giỏ hàng (Gọi trực tiếp từ nút)
        function addToCartFromDetail(btn) {
            const qtyToAdd = parseInt(document.getElementById('detailQty').value) || 1;

            const product = {
                id: btn.getAttribute('data-id').toString(),
                name: btn.getAttribute('data-name'),
                price: parseFloat(btn.getAttribute('data-price')),
                image: btn.getAttribute('data-image') || '/images/no-image.png',
                quantity: qtyToAdd
            };

            let cart = JSON.parse(localStorage.getItem(CART_KEY)) || [];
            const existing = cart.find(i => i.id === product.id);

            if (existing) {
                existing.quantity += qtyToAdd;
            } else {
                cart.push(product);
            }

            localStorage.setItem(CART_KEY, JSON.stringify(cart));

            // Cập nhật giao diện Header
            if (typeof window.updateCartUI === "function") {
                window.updateCartUI();
            } else {
                // Nếu chưa có hàm tổng thì tự cập nhật số badge
                const badge = document.getElementById('cart-badge');
                if(badge) badge.innerText = cart.length;
            }

            // Hiện thông báo
            alert("Đã thêm " + qtyToAdd + " " + product.name + " vào giỏ hàng!");

            // Mở giỏ hàng nhanh
            /*
            const offcanvasEl = document.getElementById('cartOffcanvas');
            if (offcanvasEl) {
                const bsOffcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                bsOffcanvas.show();
            }
            */
        }
    </script>
}