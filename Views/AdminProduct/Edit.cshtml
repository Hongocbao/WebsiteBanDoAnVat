@model WebsiteBanDoAnVat.Models.MonAn

<div class="container mt-5">
    <h2 class="text-danger fw-bold mb-4">CHỈNH SỬA MÓN ĂN</h2>
    <div class="card shadow border-0 p-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Tên món</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên món ăn..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Giá bán</label>
                    <input asp-for="Price" class="form-control" type="number" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Danh mục</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-4 mt-3 p-3 border rounded-3 bg-light">
                <div class="form-check form-switch fs-5">
                    <input class="form-check-input" type="checkbox" asp-for="IsBestSeller" id="bestSellerSwitch">
                    <label class="form-check-label fw-bold text-danger" for="bestSellerSwitch">
                        🔥 Đánh dấu là Món Bán Chạy
                    </label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Hình ảnh hiện tại</label><br />
                <img src="@Model.ImageUrl" width="150" class="rounded mb-2 shadow-sm" />
                <input type="file" name="imageFile" class="form-control" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger px-4">LƯU THAY ĐỔI</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">HỦY</a>
            </div>
        </form>
    </div>
</div>