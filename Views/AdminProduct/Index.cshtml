@model IEnumerable<WebsiteBanDoAnVat.Models.MonAn>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger fw-bold">QUẢN LÝ THỰC ĐƠN</h2>
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow">
            <i class="fas fa-plus me-2"></i>Thêm món mới
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ảnh</th>
                    <th>Tên món</th>
                    <th>Loại</th>
                    <th>Giá</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><img src="@item.ImageUrl" width="60" class="rounded shadow-sm" onerror="this.src='/images/no-image.png'"></td>
                        <td class="fw-bold">@item.Name</td>
                        <td><span class="badge bg-info text-dark">@item.Category?.Name</span></td>
                        <td class="text-danger">@item.Price.ToString("N0")đ</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                            <a class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>