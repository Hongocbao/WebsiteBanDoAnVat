@model IEnumerable<WebsiteBanDoAnVat.Models.ApplicationUser>

<form method="get" asp-action="KhachHang" class="mb-3">
    <div class="input-group" style="max-width: 400px;">
        <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tìm tên, SĐT hoặc MSSV...">
        <button class="btn btn-primary" type="submit">Tìm kiếm</button>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Họ và Tên</th>
            <th>MSSV</th>
            <th>Số điện thoại</th>
            <th>Ngày đăng ký</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.HoTen</td>
                <td>@(item.IsSinhVien? item.MaSinhVien: "Khách ngoài")</td>
                <td>@item.PhoneNumber</td>
                <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                <td>
                    <form asp-action="DeleteKhachHang" asp-route-id="@item.Id" method="post"
                          onsubmit="return confirm('Xác nhận xóa khách hàng này?')">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>