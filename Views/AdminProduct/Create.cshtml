@model WebsiteBanDoAnVat.Models.MonAn

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="mb-0 fw-bold text-center">THÊM MÓN ĂN VẶT MỚI</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tên món (Name)</label>
                            <input asp-for="Name" class="form-control rounded-3" placeholder="Nhập tên món ăn..." />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Danh mục</label>
                                <div class="input-group">
                                    <select asp-for="CategoryId" class="form-select rounded-start-3" asp-items="ViewBag.Categories">
                                        <option value="">-- Chọn loại món --</option>
                                    </select>
                                    <a asp-controller="Home" asp-action="CategoryCreate" class="btn btn-outline-danger" title="Thêm danh mục mới">+</a>
                                </div>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Giá bán (Price)</label>
                                <input asp-for="Price" type="number" class="form-control rounded-3" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mô tả (Description)</label>
                            <textarea asp-for="Description" class="form-control rounded-3" rows="3"></textarea>
                        </div>
                        <div class="mb-4 mt-3 p-3 border rounded-3 bg-light">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsBestSeller" id="bestSellerSwitch">
                                <label class="form-check-label fw-bold text-danger" for="bestSellerSwitch">
                                    🔥 Đánh dấu là Món Bán Chạy
                                </label>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Hình ảnh sản phẩm</label>
                            <input type="file" name="imageFile" class="form-control rounded-3" accept="image/*" />
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-light px-4 rounded-pill border">Hủy</a>
                            <button type="submit" class="btn btn-danger px-5 rounded-pill shadow">LƯU MÓN ĂN</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>